# Root directory
/venv/
.env


# Python cache
__pycache__/
*.pyc


# Frontend
/frontend/node_modules/
/frontend/.DS_Store
/frontend/dist
/frontend/dist-ssr
/frontend/*.local
/frontend/.cache
/frontend/coverage
/frontend/lerna-debug.log*
/frontend/*.suo
/frontend/*.ntvs*
/frontend/*.njsproj
/frontend/*.sln
/frontend/*.sw?

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo
*~
# Keep recommended editor settings tracked
!.vscode/extensions.json

# OS
.DS_Store
Thumbs.db

# Database
*.db
*.sqlite
*.sqlite3

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Temporary files
*.tmp
*.temp
.tmp/
.temp/

# Backup files (keep the directory but not the files)
/backup/*.zip
/backup/*.tar.gz
/backup/*.sql

# WordPress uploads (large files)
/wordpress/
/wordpress/*/wp-content/uploads/
